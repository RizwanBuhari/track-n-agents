# Copy to .env (never commit .env). Every value below is a placeholder.
# Just looking? `cd backend && npm run sample` needs none of this: no Docker,
# Zetaris, databases or Nightshift (see "Quick look: sample mode" in the README).

# --- Zetaris (local Docker install; create the API key in the Zetaris web UI) ---
ZETARIS_UI_URL=http://localhost:3002
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# --- Meterless Nightshift (Console -> Runtime URL and API key) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# Pinned NVIDIA Nemotron lanes (optional overrides)
METERLESS_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# OCR for scanned AWBs: a vision model in a Nightshift lane (optional; without it scans go to manual entry)
METERLESS_VISION_MODEL=local-runtime/paddleocr-vl-1.6

# --- Track-N local databases (started by infra/docker-compose.yml; local-only defaults) ---
OPS_DB_URL=postgres://trackn:trackn_local_only@127.0.0.1:5433/trackn_ops
FINANCE_DB_URL=mysql://trackn:trackn_local_only@127.0.0.1:3307/trackn_finance

# Address the Zetaris container uses to reach this backend's simulated APIs
# ZETARIS_CALLBACK_BASE=http://host.docker.internal:4100
